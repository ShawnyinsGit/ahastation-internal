{
  "appId": "com.ahameet.app",
  "productName": "AhaMeet",
  "icon": "build/icon.icns",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json"
  ],
  "asarUnpack": [
    "**/node_modules/@anthropic-ai/**/*",
    "**/node_modules/@openai/codex-darwin-*/**/*",
    "**/node_modules/@openai/codex-linux-*/**/*",
    "**/node_modules/@openai/codex-win32-*/**/*",
    "**/node_modules/@qoder-ai/qodercli/**/*",
    "**/node_modules/@lydell/node-pty-*/**/*",
    "**/node_modules/opencode-*/bin/**",
    "dist/vad/**/*",
    "dist/voice-id/**/*"
  ],
  "extraResources": [
    { "from": "build/whisper", "to": "whisper", "filter": ["**/*"] },
    { "from": "build/claude-defaults", "to": "claude-defaults", "filter": ["**/*"] }
  ],
  "afterPack": "scripts/sign-helpers.mjs",
  "mac": {
    "category": "public.app-category.developer-tools",
    "target": [
      { "target": "dmg", "arch": ["arm64"] }
    ],
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "build/entitlements.mac.plist",
    "entitlementsInherit": "build/entitlements.mac.plist",
    "extendInfo": {
      "NSMicrophoneUsageDescription": "AhaMeet 需要使用麦克风进行语音输入、转写和会议交互。"
    }
  },
  "dmg": {
    "icon": null,
    "title": "AhaMeet ${version}"
  },
  "win": {
    "target": [
      { "target": "nsis", "arch": ["x64", "arm64"] }
    ],
    "icon": "build/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true
  },
  "linux": {
    "target": [
      { "target": "AppImage", "arch": ["x64", "arm64"] },
      { "target": "deb", "arch": ["x64", "arm64"] }
    ],
    "icon": "build/icon.png",
    "category": "Development"
  }
}
